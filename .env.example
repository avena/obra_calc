# Obra Calc — Backend Lumen + MariaDB (Ticket 01)
#
# Copie este arquivo para `.env` antes de subir o ambiente:
#   cp .env.example .env
#
# O `just lumen-up` exige que `.env` exista (veja o justfile).
# Nunca commite o `.env` (está no .gitignore).

# ── App (Lumen) ──
APP_NAME="Obra Calc"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8084

# ── Banco de dados (Lumen → MariaDB) ──
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=obra_calc
DB_USERNAME=lumens
DB_PASSWORD=secret

# ── Credenciais do MariaDB (usadas pelo serviço `db` do docker-compose.yml) ──
MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_DATABASE=obra_calc
MYSQL_USER=lumens
MYSQL_PASSWORD=secret
